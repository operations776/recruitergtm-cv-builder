# Copy this file to .env.local (local dev) and set the same keys in Vercel:
# Project -> Settings -> Environment Variables.
# NEVER commit real keys. .env.local is gitignored.

# OpenAI — parses pasted CV text + structures the final CV JSON
OPENAI_API_KEY=

# Exa — reverse-searches the real person on the open web
EXA_API_KEY=

# Shared password gate for the whole team (any non-empty string)
APP_PASSWORD=

# Prospeo — finds the candidate's verified work email (1 credit) and mobile (10 credits)
PROSPEO_API_KEY=

# Apify — scrapes the full LinkedIn profile so CVs are built from real profile
# data (all roles + descriptions, certifications, projects, recommendations).
# ~$0.004 per profile. Optional: without it the app falls back to Exa summaries.
APIFY_TOKEN=

# Postgres (Vercel Storage -> Neon). Injected automatically when you attach a
# database to the project. Optional: without it, run history is simply hidden.
DATABASE_URL=

# Optional: model override (defaults to a cost-effective structured model)
# OPENAI_MODEL=gpt-4o-mini
