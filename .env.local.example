# Copy this file to .env.local (local dev) and set the same keys in Vercel:
# Project -> Settings -> Environment Variables.
# NEVER commit real keys. .env.local is gitignored.

# OpenAI — parses pasted CV text + structures the final CV JSON
OPENAI_API_KEY=

# Exa — reverse-searches the real person on the open web
EXA_API_KEY=

# Shared password gate for the whole team (any non-empty string)
APP_PASSWORD=

# Prospeo — finds the candidate's verified work email (1 credit) and mobile (10 credits)
PROSPEO_API_KEY=

# Optional: model override (defaults to a cost-effective structured model)
# OPENAI_MODEL=gpt-4o-mini
